ZAI_API_KEY=your-zhipu-api-key
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_AGENT_MODEL=glm-5.2
ZAI_GUARDRAIL_MODEL=glm-5.2
OPENAI_TRACING_DISABLED=1
CORS_ORIGINS=http://localhost:3000

# Local development authentication. Use AUTH_MODE=oidc for SSO production,
# or AUTH_MODE=roboage when this backend is called server-to-server by RoboAge.
AUTH_MODE=dev
DEV_AUTH_TOKEN=local-dev-token
DEV_TENANT_ID=tenant_acme_cn
DEV_USER_ID=local-admin
DEV_USER_ROLES=tenant_admin,knowledge_editor,knowledge_reviewer,support_agent,end_user

# Required when AUTH_MODE=roboage. Must match RoboAge
# ENTERPRISE_SUPPORT_AGENT_INTERNAL_TOKEN.
ROBOAGE_INTERNAL_TOKEN=

# Required when AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ROLE_MAPPING={}
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_SCOPES=openid profile email
SESSION_SIGNING_KEY=
SESSION_TTL_HOURS=8
FRONTEND_BASE_URL=http://localhost:3000

# Local pilot persistence. Production deployments should use PostgreSQL.
DATABASE_PATH=./data/enterprise_agent.db

# Production runtime. Set APP_ENV=production only after all readiness checks pass.
APP_ENV=development
DATABASE_URL=
DATA_ENCRYPTION_KEY=
ENFORCE_PRODUCTION_GATES=1

# Real connectors are read-only. Credential values stay in server-side environment variables.
CONNECTOR_MODE=demo
CONNECTOR_ENV=sandbox
CONNECTOR_ALLOWED_HOSTS=
HUBSPOT_ACCESS_TOKEN=
JIRA_API_TOKEN=
USAGE_API_TOKEN=
CONFLUENCE_API_TOKEN=

# Production document processing uses S3-compatible object storage and a separate worker.
DOCUMENT_PROCESSING_MODE=sync
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_PATH=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_KMS_KEY_ID=
CLAMAV_COMMAND=
CLAMAV_REQUIRED=0

# Optional independent semantic evaluation model.
ZAI_EVAL_MODEL=glm-5.2
