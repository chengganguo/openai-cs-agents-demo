POSTGRES_PASSWORD=replace-with-secret-manager-reference
MINIO_ROOT_USER=replace-with-secret-manager-reference
MINIO_ROOT_PASSWORD=replace-with-secret-manager-reference
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=replace-with-production-domain-key

ZAI_API_KEY=replace-with-secret-manager-reference
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_AGENT_MODEL=glm-5.2
ZAI_GUARDRAIL_MODEL=glm-5.2
OPENAI_TRACING_DISABLED=1

AUTH_MODE=oidc
OIDC_ISSUER=https://idp.example.com
OIDC_AUDIENCE=enterprise-agent
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth2/authorize
OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth2/token
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-secret-manager-reference
OIDC_REDIRECT_URI=https://agent.example.com/auth/callback
OIDC_GROUP_ROLE_MAPPING={"agent-admins":["tenant_admin"],"support-team":["support_agent"]}
SESSION_SIGNING_KEY=replace-with-32-byte-or-longer-random-secret
FRONTEND_BASE_URL=https://agent.example.com

DATA_ENCRYPTION_KEY=replace-with-fernet-key
CORS_ORIGINS=https://agent.example.com
CONNECTOR_MODE=live
CONNECTOR_ENV=production
CONNECTOR_ALLOWED_HOSTS=usage.example.com
ENFORCE_PRODUCTION_GATES=1

HUBSPOT_ACCESS_TOKEN=replace-with-read-only-secret
JIRA_API_TOKEN=replace-with-read-only-secret
USAGE_API_TOKEN=replace-with-read-only-secret
CONFLUENCE_API_TOKEN=replace-with-read-only-secret
